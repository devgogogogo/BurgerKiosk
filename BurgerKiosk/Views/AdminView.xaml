<Window x:Class="BurgerKiosk.Views.AdminView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BurgerKiosk.Views"
        mc:Ignorable="d"
        Title="AdminView" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        
        <!--상단 타이틀-->
        <TextBlock Grid.Row="0"
                   Text="주문목록"
                   FontSize="24"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>
        <!--주문목록-->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Orders}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="주문번호" Width="80" Binding="{Binding Id}"/>
                <DataGridTextColumn Header="주문시간" Width="150" Binding="{Binding OrderedAt}"/>
                <DataGridTextColumn Header="상태" Width="80" Binding="{Binding Status}"/>
                <DataGridTextColumn Header="총금액" Width="80" Binding="{Binding TotalPrice}"/>

                <!--상태 변경 버튼-->
                <DataGridTemplateColumn Header="상태변경" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="완료처리"
                                    Width="80"
                                    Height="25"
                                    Command="{Binding DataContext.CompleteOrderCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- 삭제 버튼-->
                <DataGridTemplateColumn Header="삭제" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="삭제"
                                Width="60" Height="25"
                                Command="{Binding DataContext.DeleteOrderCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Button Grid.Row="2"
                Content="닫기"
                Width="100"
                Height="40"
                HorizontalAlignment="Right"
                Margin="10"
                Click="CloseButton_Click"/>
    </Grid>
</Window>
