<Window x:Class="BurgerKiosk.Views.CartView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BurgerKiosk.Views"
        mc:Ignorable="d"
        Title="장바구니" Height="700" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <!-- 상단 헤더 -->
        <Border Grid.Row="0" Background="#F97316">
            <Grid Margin="20 0">
                <TextBlock Text="장바구니"
                           FontSize="22" FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
                <Button Content="← 뒤로"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Width="70" Height="34"
                        Background="Transparent"
                        Foreground="White"
                        BorderBrush="White"
                        BorderThickness="1"
                        Click="BackButton_Click"/>
            </Grid>
        </Border>

        <!-- 장바구니 목록 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding CartItems}" Margin="12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0 0 0 10"
                                Background="White"
                                CornerRadius="12"
                                BorderBrush="#E5E5E5"
                                BorderThickness="1">
                            <Grid Margin="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 메뉴 이미지 -->
                                <Border Grid.Column="0"
                                        Width="72" Height="72"
                                        CornerRadius="10"
                                        ClipToBounds="True">
                                    <Image Source="{Binding Menu.ImagePath}"
                                           Stretch="UniformToFill"/>
                                </Border>

                                <!-- 메뉴 정보 -->
                                <StackPanel Grid.Column="1"
                                            Margin="12 0 0 0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Menu.Name}"
                                               FontSize="15" FontWeight="Bold"
                                               Foreground="#1C1917"/>
                                    <TextBlock FontSize="14"
                                               Foreground="#F97316"
                                               FontWeight="Bold"
                                               Margin="0 4 0 0">
                                        <Run Text="₩"/>
                                        <Run Text="{Binding Menu.Price, StringFormat='{}{0:N0}'}"/>
                                    </TextBlock>

                                    <!-- 수량 조절 -->
                                    <StackPanel Orientation="Horizontal" Margin="0 8 0 0">
                                        <Button Content="-"
                                                Width="28" Height="28"
                                                FontSize="16"
                                                Background="#F5F5F5"
                                                BorderThickness="1"
                                                BorderBrush="#E5E5E5"
                                                Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                        <TextBlock Text="{Binding Quantity}"
                                                   Width="36"
                                                   TextAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="15"
                                                   FontWeight="Bold"/>
                                        <Button Content="+"
                                                Width="28" Height="28"
                                                FontSize="16"
                                                Background="#F5F5F5"
                                                BorderThickness="1"
                                                BorderBrush="#E5E5E5"
                                                Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- 합계 + 삭제 -->
                                <StackPanel Grid.Column="2"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right">
                                    <TextBlock FontSize="15" FontWeight="Bold"
                                               Foreground="#1C1917"
                                               HorizontalAlignment="Right">
                                        <Run Text="₩"/>
                                        <Run Text="{Binding TotalPrice, StringFormat='{}{0:N0}', Mode=OneWay}"/>
                                    </TextBlock>
                                    <Button Content="삭제"
                                            Width="50" Height="26"
                                            FontSize="11"
                                            Foreground="#888"
                                            Background="Transparent"
                                            BorderBrush="#E5E5E5"
                                            BorderThickness="1"
                                            Margin="0 8 0 0"
                                            Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 하단 주문 바 -->
        <Border Grid.Row="2" Background="#1C1917">
            <Grid Margin="20 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 총 금액 -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="총 금액"
                               FontSize="13"
                               Foreground="#888"
                               VerticalAlignment="Center"/>
                    <TextBlock FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="10 0 0 0"
                               VerticalAlignment="Center">
                        <Run Text="₩"/>
                        <Run Text="{Binding TotalPrice, StringFormat='{}{0:N0}', Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>

                <!-- 주문 완료 버튼 -->
                <Button Grid.Column="1"
                        Content="주문 완료"
                        Width="120" Height="40"
                        Background="#F97316"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        FontWeight="Bold"
                        VerticalAlignment="Center"
                        Command="{Binding CompleteOrderCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>