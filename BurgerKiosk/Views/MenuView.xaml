<Window x:Class="BurgerKiosk.Views.MenuView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BurgerKiosk.Views"
        mc:Ignorable="d"
        Title="버거 키오스크" Height="700" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <!-- 상단 헤더 -->
        <Border Grid.Row="0" Background="#F97316">
            <Grid Margin="20 0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="버거 키오스크"
                               FontSize="22" FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="메뉴를 선택해주세요"
                               FontSize="12"
                               Foreground="#FFE0C8"/>
                </StackPanel>
                <Button Content="관리자"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Width="70" Height="34"
                        Background="Transparent"
                        Foreground="White"
                        BorderBrush="White"
                        BorderThickness="1"
                        Click="AdminButton_Click"/>
            </Grid>
        </Border>

        <!-- 메뉴 목록 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="MenuList"
                          ItemsSource="{Binding Menus}"
                          Margin="12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0 0 0 10"
                                Background="White"
                                CornerRadius="12"
                                BorderBrush="#E5E5E5"
                                BorderThickness="1">
                            <Grid Margin="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>

                                <!-- 메뉴 이미지 -->
                                <Border Grid.Column="0"
                                        Width="72" Height="72"
                                        CornerRadius="10"
                                        ClipToBounds="True">
                                    <Image Source="{Binding ImagePath}"
                                           Stretch="UniformToFill"/>
                                </Border>

                                <!-- 메뉴 정보 -->
                                <StackPanel Grid.Column="1"
                                            Margin="12 0 0 0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="#1C1917"/>
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="11"
                                               Foreground="#888"
                                               Margin="0 4 0 0"
                                               TextWrapping="Wrap"/>
                                    <TextBlock FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="#F97316"
                                               Margin="0 8 0 0">
                                        <Run Text="₩"/>
                                        <Run Text="{Binding Price, StringFormat='{}{0:N0}'}"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- 추가 버튼 -->
                                <Button Grid.Column="2"
                                        Width="32" Height="32"
                                        Content="+"
                                        FontSize="20"
                                        Background="#F97316"
                                        Foreground="White"
                                        BorderThickness="0"
                                        VerticalAlignment="Center"
                                        Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="16"
                                                    Width="32" Height="32">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 하단 장바구니 바 -->
        <Border Grid.Row="2" Background="#1C1917">
            <Grid Margin="20 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 장바구니 아이콘 -->
                <Border Grid.Column="0"
                        Width="36" Height="36"
                        CornerRadius="18"
                        Background="#333"
                        VerticalAlignment="Center">
                    <TextBlock Text="🛒"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- 장바구니 텍스트 -->
                <StackPanel Grid.Column="1"
                            Margin="12 0 0 0"
                            VerticalAlignment="Center">
                    <TextBlock Text="장바구니"
                               FontSize="12"
                               Foreground="#888"/>
                </StackPanel>

                <!-- 장바구니 보기 버튼 -->
                <Button Grid.Column="2"
                        Content="장바구니 보기"
                        Width="130" Height="40"
                        Background="#F97316"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="13"
                        FontWeight="Bold"
                        VerticalAlignment="Center"
                        Click="CartButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>